# Production .env for the database host: copy to .env (mode 0600) and fill in
# the placeholders. scripts/bootstrap.sh does the copy and generates the two
# database passwords; you add the R2 keys, the tunnel token and the image
# bucket. Everything not listed here keeps its built-in default (loopback
# listeners, /data and /logs roots, resource limits; see .env.example for
# the full list).

# --- postgres ----------------------------------------------------------------
POSTGRES_USER=trading-bots
# URL-safe characters only (letters, digits, - _ . ~): the trading host
# splices it into DATABASE_URL without URL-encoding. bootstrap.sh generates it.
POSTGRES_PASSWORD=
POSTGRES_DB=trading-bots-db

# --- clickhouse --------------------------------------------------------------
CLICKHOUSE_USER=trading-bots
# bootstrap.sh generates it.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=trading_bots

# --- cloudflare tunnel -------------------------------------------------------
# The db host's tunnel: `just db-token` in trading-bots-host-setup/cloudflare.
# It carries db.<domain> (postgres), chdb.<domain> (ClickHouse HTTP),
# scraper.<domain> and metrics-db.<domain>. The trading host reaches them
# through Access by its elastic IPs (bypass_cidrs); no token on that side.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=<db tunnel token>

# --- backups: wal-g to Cloudflare R2 -----------------------------------------
# R2 > Create bucket, then R2 > Manage R2 API Tokens > Create API token with
# "Object Read & Write" on this bucket (an S3-style key pair, not a regular
# Cloudflare API token). The account id is in the dashboard URL.
# scripts/deploy.sh refuses to run without this section (ALLOW_NO_BACKUPS=1
# overrides, for testing only).
WALG_S3_PREFIX=s3://trading-bots-db/walg
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_S3_FORCE_PATH_STYLE=true
AWS_REGION=auto
AWS_ACCESS_KEY_ID=<r2 access key id>
AWS_SECRET_ACCESS_KEY=<r2 secret access key>
WALG_COMPRESSION_METHOD=lz4

# --- scraper image -----------------------------------------------------------
# The trading-bots repo's CI publishes the scraper image to this R2 bucket on
# release tags; deploy.sh pulls the newest with the wal-g credentials above
# (give that token Object Read on this bucket too, or use one token for
# both). Unset = no scraper on this host.
IMAGES_S3_BUCKET=trading-bots-images
