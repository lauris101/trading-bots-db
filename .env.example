# The ONE config file for the database host: copy to .env and fill in the
# secrets (or let scripts/bootstrap.sh generate them). docker compose
# interpolates it, and the postgres container also loads it directly
# (env_file) so wal-g sees the backup credentials.

# --- postgres ----------------------------------------------------------------
POSTGRES_USER=trading-bots
# REQUIRED. URL-safe characters only (letters, digits, - _ . ~): the app
# stack splices it into DATABASE_URL without URL-encoding.
POSTGRES_PASSWORD=
POSTGRES_DB=trading-bots-db
# Host address/port the container is published on. Default loopback. A dev
# box that also runs the trading-bots stack in docker sets
# POSTGRES_BIND=172.17.0.1 (docker0: reachable from containers as
# host.docker.internal and from the host; not from outside). Never 0.0.0.0.
#POSTGRES_BIND=127.0.0.1
#POSTGRES_PORT=5432
#POSTGRES_MAX_CONNECTIONS=200
#POSTGRES_CPUS=2.0
#POSTGRES_MEMORY=2g

# --- clickhouse --------------------------------------------------------------
CLICKHOUSE_USER=trading-bots
# REQUIRED.
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=trading_bots
#CLICKHOUSE_BIND=127.0.0.1
#CLICKHOUSE_HTTP_PORT=8123
#CLICKHOUSE_NATIVE_PORT=9000
#CLICKHOUSE_CPUS=2.0
#CLICKHOUSE_MEMORY=4g

# --- host directories ----------------------------------------------------------
# Data:  ${DATA_BASE_DIR}/data/trading-bots/postgres and .../clickhouse
# Logs:  ${LOGS_BASE_DIR}/logs/trading-bots/<UTC day>/<service>.log
# Both default to empty, i.e. /data/trading-bots/... and /logs/trading-bots/...
# Finished log days are gzipped; day directories older than LOG_KEEP_DAYS go.
#DATA_BASE_DIR=
#LOGS_BASE_DIR=
#LOG_KEEP_DAYS=7
# The host loopback port fluentd listens on; change it when another stack on
# the same box already uses 24224.
#FLUENTD_PORT=24224
# Host loopback port of node-exporter (metrics-db.<domain> points here).
#NODE_EXPORTER_PORT=9100

# --- scraper -------------------------------------------------------------------
# The market-data scraper image, published by the trading-bots repo's CI on
# release tags (ghcr.io/lauris101/trading-bots-scraper:<tag>). Pulling a
# private package needs a one-time `docker login ghcr.io` on this host with a
# GitHub token that has read:packages. Pin a tag in production.
#SCRAPER_IMAGE=ghcr.io/lauris101/trading-bots-scraper:latest
#SCRAPER_PORT=8084
#SCRAPER_RECORDER=db-host

# --- cloudflare tunnel ---------------------------------------------------------
# Expose the databases as Access-gated TCP hostnames with no inbound port:
# create the tunnel (Zero Trust > Networks > Tunnels), add the public
# hostnames listed in docker-compose.yml, paste the token here and add
# `tunnel` to COMPOSE_PROFILES.
#CLOUDFLARE_TUNNEL_TOKEN=

# --- compose profiles ----------------------------------------------------------
# devstack : minio as a local S3 stand-in for wal-g (laptop)
# tunnel   : cloudflared (server)
COMPOSE_PROFILES=devstack
MINIO_ROOT_USER=minioadmin
# REQUIRED when the devstack profile is on.
MINIO_ROOT_PASSWORD=
# Bucket minio-init creates; must match WALG_S3_PREFIX below.
WALG_BUCKET=trading-bots-db
#MINIO_PORT=9002
#MINIO_CONSOLE_PORT=9001

# =============================================================================
# wal-g / backups: uncomment and fill in ONE backend section.
# Leaving WALG_S3_PREFIX unset keeps WAL archiving off (fail-soft; deploy.sh
# refuses to run that way unless ALLOW_NO_BACKUPS=1).
# =============================================================================

# --- backend: minio (dev default; matches the devstack profile) ---------------
WALG_S3_PREFIX=s3://trading-bots-db/walg
AWS_ENDPOINT=http://minio:9000
AWS_S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
# Match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD above.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-me

# --- backend: Cloudflare R2 (production) --------------------------------------
# 1. Create the bucket in the Cloudflare dashboard (R2 > Create bucket).
# 2. Create an S3 API token: R2 > Manage R2 API Tokens > Create API token,
#    permission "Object Read & Write", scoped to the bucket. That yields the
#    Access Key ID / Secret below (NOT a regular Cloudflare API token).
# 3. Your account id is in the dashboard URL / R2 overview page.
#WALG_S3_PREFIX=s3://trading-bots-db/walg
#AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#AWS_S3_FORCE_PATH_STYLE=true
#AWS_REGION=auto
#AWS_ACCESS_KEY_ID=<r2-access-key-id>
#AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>

# --- backend: AWS S3 -----------------------------------------------------------
# No AWS_ENDPOINT / AWS_S3_FORCE_PATH_STYLE: those are for minio/R2 only.
#WALG_S3_PREFIX=s3://<your-s3-bucket>/walg
#AWS_REGION=<bucket-region>
#AWS_ACCESS_KEY_ID=<access-key-id>
#AWS_SECRET_ACCESS_KEY=<secret-access-key>

# Compression: lz4 is fast and verified against the pinned wal-g v3.0.9.
WALG_COMPRESSION_METHOD=lz4
